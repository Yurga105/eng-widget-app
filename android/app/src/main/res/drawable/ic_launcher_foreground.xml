<?xml version="1.0" encoding="utf-8"?>
<!-- Передний план адаптивной иконки приложения: буква «W» с янтарной
     точкой («W.» — слово дня). Холст 108dp, безопасная зона r≈33dp
     вокруг центра (54,54) — все элементы внутри неё. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- «W»: четыре штриха, скруглённые линии -->
    <path
        android:pathData="M34,43 L44,65 L54,43 L64,65 L74,43"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- янтарная точка-«период» на базовой линии -->
    <path
        android:fillColor="#FFFFB300"
        android:pathData="M79,60 m-5,0 a5,5 0 1,1 10,0 a5,5 0 1,1 -10,0" />
</vector>
