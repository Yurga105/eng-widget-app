<?xml version="1.0" encoding="utf-8"?>
<!-- Макет виджета 4×2 (PLAN.md §1, §6): слово → транскрипция → перевод →
     пример (до 2 строк с ellipsize). Только RemoteViews-совместимые view
     (LinearLayout, TextView). Тексты — статическая заглушка этапа 3,
     провайдер заменяет их на актуальные в onUpdate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/widget_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_word_color"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/word_widget_preview_word" />

    <TextView
        android:id="@+id/widget_transcription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_transcription_color"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="@string/word_widget_preview_transcription" />

    <TextView
        android:id="@+id/widget_translation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_translation_color"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="2dp"
        android:text="@string/word_widget_preview_translation" />

    <TextView
        android:id="@+id/widget_example"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_example_color"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="4dp"
        android:text="@string/word_widget_preview_example" />
</LinearLayout>
